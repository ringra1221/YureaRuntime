
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "1. Build Analysis Module",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-fmodules-ts",
                "-g",
                "-x",
                "c++",
                "-c",
                "src/analysis/analysis.cppm",
                "-o",
                "analysis.o"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "2. Build Graphic Module",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-fmodules-ts",
                "-g",
                "-x",
                "c++",
                "-c",
                "src/graphic/graphic.cppm",
                "-o",
                "graphic.o"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "dependsOn": [
                "1. Build Analysis Module"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "3. Build Executable",
            "command": "g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++20",
                "-fmodules-ts",
                "-g",

                "analysis.o",
                "graphic.o",
                "main.cpp",

                "-o",
                "${workspaceFolder}/main.exe",

                "-lSDL3",
                "-lSDL3_ttf",
                "-lSDL3_image"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "dependsOn": [
                "2. Build Graphic Module"
            ],
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
